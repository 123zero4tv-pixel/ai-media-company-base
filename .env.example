# AI Media Company runtime configuration
# Copy these values into the runtime environment. Never commit real secrets.

# OpenAI-compatible endpoint. For local Ollama use: http://localhost:11434/v1
AI_BASE_URL=http://localhost:11434/v1

# Model name available at the configured endpoint.
AI_MODEL=gemma4:e4b

# Local endpoints can use any non-empty placeholder because no paid API key is required.
# For a remote provider, replace this with the real secret in the runtime environment.
AI_API_KEY=ollama

# Optional request timeout in milliseconds.
AI_TIMEOUT_MS=60000
